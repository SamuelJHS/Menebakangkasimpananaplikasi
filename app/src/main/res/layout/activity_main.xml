<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Game Tebak Angka"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtSkor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Skor: 100"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/txtPetunjuk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tebak angka antara 0 sampai 100!"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/inputTebakan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukkan tebakanmu (0-100)"
        android:inputType="number"
        android:gravity="center"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <!-- Tombol Tebak (Bisa disembunyikan pakai View.GONE) -->
    <Button
        android:id="@+id/btnTebak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TEBAK SEKARANG"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Tombol Reset / Main Lagi -->
    <Button
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MULAI ULANG / RESET"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>